# .env.example을 .env로 복사한 뒤 값을 채우세요. (.env는 커밋하지 않음)

# [필수] Gemini API 키: 추출(그림·표 해석), 임베딩, Agent 답변, 답변 평가(채점)에 사용
GEMINI_API_KEY=your-gemini-api-key

# [선택] Chroma 벡터 DB 저장 위치
# 비워 두면 프로젝트의 chroma_db/에 저장해요.
# Windows에서 경로에 한글이 있으면 자동으로 C:/Users/Public/financial-rag-agent/chroma_db에 저장해요.
# CHROMA_DIR=C:/chroma/financial-rag-agent
